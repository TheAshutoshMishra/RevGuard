# RevGuard local development environment variables.
# Copy this file to .env and adjust values as needed.
# Never commit a real .env file or real credentials.

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=revguard
POSTGRES_USER=revguard
POSTGRES_PASSWORD=revguard

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Redpanda (Kafka-compatible event streaming) ---
REDPANDA_BROKERS=redpanda:9092

# --- AI Service ---
AI_SERVICE_URL=http://ai-service:8000

# AI_PROVIDER selects the LLM provider: "mock" (default; deterministic,
# no credentials needed, used automatically in tests/dev) or "anthropic"
# (real model calls, requires ANTHROPIC_API_KEY below).
AI_PROVIDER=mock

# Only required when AI_PROVIDER=anthropic. Never commit a real key —
# this file only ever contains a placeholder.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Backend ---
BACKEND_PORT=8080

# How long the backend waits for a single AI diagnosis request before
# giving up (the RecoveryCase is left in ANALYZING on failure/timeout).
AI_REQUEST_TIMEOUT_SECONDS=20

# --- Policy Profile (Milestone 10) ---
# POLICY_PROFILE selects which named policy configuration PolicyEngine
# evaluates against: "conservative", "balanced" (default; numerically
# identical to the original Milestone 5 default policy), or "aggressive".
# See docs/architecture/policy-engine.md for exact thresholds.
POLICY_PROFILE=balanced

# --- Payment Provider (Execution Engine) ---
# PAYMENT_PROVIDER selects the ExecutionEngine's provider: "fake" (default;
# deterministic, no credentials needed, used automatically in tests/dev) or
# "razorpay" (a minimal, honestly-scoped Payment Links adapter, requires
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET below).
PAYMENT_PROVIDER=fake

# Only required when PAYMENT_PROVIDER=razorpay. Never commit real keys —
# this file only ever contains placeholders. Use Razorpay TEST MODE keys
# only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_BASE_URL=

# --- Webhooks & Reconciliation (Milestone 7) ---
# Authenticates inbound Razorpay webhooks (HMAC-SHA256 of the raw request
# body). Left empty, every webhook is rejected — verification fails
# closed, never open. Use a Razorpay TEST MODE webhook secret only.
RAZORPAY_WEBHOOK_SECRET=

# Configure the default (fake) PaymentReconciler used when
# PAYMENT_PROVIDER=fake, mirroring FakeProvider's determinism. Ignored
# when PAYMENT_PROVIDER=razorpay (RazorpayReconciler reuses the
# RAZORPAY_* credentials above). RECONCILER_FAKE_AMOUNT_MINOR_UNITS
# defaults to 0, which is deliberately inert (never fabricates a SUCCESS
# outcome) unless explicitly set to a positive amount.
RECONCILER_FAKE_SCENARIO=payment_captured
RECONCILER_FAKE_AMOUNT_MINOR_UNITS=0
RECONCILER_FAKE_CURRENCY=INR

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
